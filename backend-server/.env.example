# Copy to .env and adjust. All values are optional for local dev.

# Port the backend listens on (default 3000)
PORT=3000

# Upstream Verifier API (Leul). REQUIRED for real verifications to succeed.
# Without a key the upstream returns: {"success":false,"error":"API key is required"}
VERIFIER_BASE_URL=https://verifyapi.leulzenebe.pro
VERIFIER_UPSTREAM_KEY=

# Upstream request timeout in milliseconds (default 20000)
VERIFIER_TIMEOUT_MS=20000

# Optional gate for the /api/verify endpoint. If set, clients must send a
# matching `x-api-key` header. Leave blank to run unguarded (dev).
# Configure the matching client header through secure build configuration.
VERIFY_API_KEY=
