# Copy to .env and adjust. Supabase credentials are required for the
# authenticated verify-and-create workflow.

NODE_ENV=development
CHEKMI_ENV=development

# Port the backend listens on (default 3000)
PORT=3000

# CHEKMI owns the provider fetch/parsing route. Run this server from an
# Ethiopian IP for direct mode, or configure private Ethiopian relays.
CHEKMI_PROVIDER_EGRESS=direct
SKIP_PRIMARY_VERIFICATION=false

# live calls the real verifier. fixtures enables deterministic CHEKMI-* test
# references and is rejected at startup when CHEKMI_ENV=production.
CHEKMI_VERIFIER_MODE=live

# Provider request timeout in milliseconds (default 20000)
PROVIDER_TIMEOUT_MS=20000

# Optional development/test URL overrides. Leave blank in production to use
# the official provider receipt endpoints.
TELEBIRR_RECEIPT_BASE_URL=
CBE_LEGACY_RECEIPT_URL=
CBE_NEW_RECEIPT_BASE_URL=
DASHEN_RECEIPT_BASE_URL=
ABYSSINIA_RECEIPT_BASE_URL=
CBEBIRR_RECEIPT_BASE_URL=
MPESA_RECEIPT_URL=

# Private Ethiopian relays. Never ship these secrets in Flutter or commit them.
TELEBIRR_PROXY_URLS=
TELEBIRR_PROXY_KEY=
CBE_PROXY_URL=
CBE_PROXY_KEY=
MPESA_PROXY_URL=
MPESA_PROXY_KEY=

# Required only for direct verification of new-format CBE receipt tokens.
CBE_APP_ID=
CBE_APP_VERSION=

# Payments older than this window are rejected. Production default: 24 hours.
TRANSACTION_MAX_AGE_MINUTES=1440

# Optional gate for the /api/verify endpoint. If set, clients must send a
# matching `x-api-key` header. Leave blank to run unguarded (dev).
# Configure the matching client header through secure build configuration.
VERIFY_API_KEY=

# Required by the authenticated atomic verification workflow. The service-role
# key belongs on this backend only and must never be bundled into Flutter.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The old verification-only route is disabled automatically in production.
# Enable it only for short-lived backend integration tests.
ALLOW_LEGACY_VERIFY=false
CORS_ALLOWED_ORIGINS=
VERIFY_RATE_LIMIT_PER_MINUTE=20

# Protected platform-owner console. Production requires the scrypt hash, a
# base32 TOTP secret (Google/Microsoft Authenticator), and a random session
# signing secret of at least 32 characters. OPERATOR_PASSWORD and
# OPERATOR_MFA_CODE are accepted only when NODE_ENV is not production.
OPERATOR_EMAIL=owner@your-domain.example
OPERATOR_PASSWORD_HASH=
OPERATOR_TOTP_SECRET=
OPERATOR_SESSION_SECRET=
OPERATOR_PASSWORD=
OPERATOR_MFA_CODE=
