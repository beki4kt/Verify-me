# Add these in Alet App Hosting's Environment Variables form, then redeploy.
# This example contains no credentials.
NODE_ENV=production
CHEKMI_ENV=production
CHEKMI_VERIFIER_MODE=live
CHEKMI_VERIFICATION_ENGINE=owned
CHEKMI_PROVIDER_EGRESS=proxy
CHEKMI_INTERNAL_LOOKUP_KEY=REPLACE_WITH_A_LONG_RANDOM_SERVER_SECRET
TELEBIRR_PROXY_URLS=https://chekmiverifier.com.et/verify.php
TELEBIRR_PROXY_KEY=REPLACE_PRIVATELY_IN_ALET
MPESA_PROXY_URL=https://chekmiverifier.com.et/mpesa.php
MPESA_PROXY_KEY=REPLACE_PRIVATELY_IN_ALET
CBE_PROXY_URL=https://chekmiverifier.com.et/verifyCbe.php
CBE_PROXY_KEY=REPLACE_PRIVATELY_IN_ALET
SKIP_PRIMARY_VERIFICATION=false
CHEKMI_RUN_PREFLIGHT=true
CBE_LEGACY_ENABLED=true
ALLOW_LEGACY_VERIFY=false
PROVIDER_TIMEOUT_MS=30000
TRANSACTION_MAX_AGE_MINUTES=1440
VERIFY_RATE_LIMIT_PER_MINUTE=20
PORT=8080
SUPABASE_URL=https://lpbdxtzyzlaioggefscc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_ALET_ONLY
# Exact browser preview origin, if using Flutter web. Native apps send no Origin.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8087,http://localhost:8087
# The Ethiopian relay injects CBE app headers in proxy mode.
CBE_APP_ID=
CBE_APP_VERSION=
