{
  "name": "@creofam/verifier",
  "version": "0.1.4",
  "description": "TypeScript SDK for the Verifier API",
  "main": "index.js",
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml,yaml}": "prettier --write"
  },
  "keywords": [],
  "author": "Leul Zenebe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vixen878/verifier-sdk-ts.git"
  },
  "bugs": {
    "url": "https://github.com/Vixen878/verifier-sdk-ts/issues"
  },
  "homepage": "https://verify.leul.et/",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/coverage-v8": "^4.0.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "tsd": "^0.33.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  },
  "dependencies": {
    "tsx": "^4.21.0"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "dev": "tsup --watch",
    "lint-staged": "lint-staged",
    "test:live": "cross-env VERIFIER_INT=1 pnpm test",
    "abebe": "pnpm exec tsx examples/cbe.ts"
  }
}