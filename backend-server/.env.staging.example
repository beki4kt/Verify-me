# Dedicated staging backend only. Create a separate hosted app and set values
# in the host's secret/environment settings. Never copy production credentials.
NODE_ENV=production
CHEKMI_ENV=staging
CHEKMI_STAGING_PROJECT_REF=YOUR_20_CHARACTER_STAGING_REF
SUPABASE_URL=https://YOUR_20_CHARACTER_STAGING_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_IN_HOST_SECRET_STORE
CHEKMI_INTERNAL_LOOKUP_KEY=SET_SAME_PRIVATE_VALUE_IN_STAGING_EDGE_SECRETS

# Synthetic references only. This mode is rejected when CHEKMI_ENV=production.
# Switch to live only after authorized provider sandbox credentials are ready.
CHEKMI_VERIFIER_MODE=fixtures
CHEKMI_VERIFICATION_ENGINE=owned
CHEKMI_RUN_PREFLIGHT=false
ALLOW_LEGACY_VERIFY=false
VERIFY_RATE_LIMIT_PER_MINUTE=20
CORS_ALLOWED_ORIGINS=
