# Names for Plesk's Custom Environment Variables. This file contains no keys.
# Passenger provides PORT dynamically. Do not set PORT in Plesk.
NODE_ENV=production
CHEKMI_ENV=production
CHEKMI_VERIFIER_MODE=live
CHEKMI_VERIFICATION_ENGINE=owned
CHEKMI_PROVIDER_EGRESS=proxy
CHEKMI_INTERNAL_LOOKUP_KEY=SET_PRIVATELY_IN_PLESK_AND_SUPABASE_EDGE
TELEBIRR_PROXY_URLS=https://chekmiverifier.com.et/verify.php
TELEBIRR_PROXY_KEY=SET_PRIVATELY_IN_PLESK
MPESA_PROXY_URL=https://chekmiverifier.com.et/mpesa.php
MPESA_PROXY_KEY=SET_PRIVATELY_IN_PLESK
CBE_PROXY_URL=https://chekmiverifier.com.et/verifyCbe.php
CBE_PROXY_KEY=SET_PRIVATELY_IN_PLESK
CHEKMI_RUN_PREFLIGHT=true
CBE_LEGACY_ENABLED=false
ALLOW_LEGACY_VERIFY=false
PROVIDER_TIMEOUT_MS=30000
TRANSACTION_MAX_AGE_MINUTES=1440
VERIFY_RATE_LIMIT_PER_MINUTE=20
SUPABASE_URL=https://lpbdxtzyzlaioggefscc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_PRIVATELY_IN_PLESK
# Add only real Flutter web origins. Native apps do not send Origin.
CORS_ALLOWED_ORIGINS=
